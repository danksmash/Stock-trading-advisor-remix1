{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/forecast.ts": { "maxDuration": 60 },
    "api/news-ja.ts": { "maxDuration": 30 },
    "api/health.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/forecast/kioxia", "destination": "/api/forecast" },
    { "source": "/api/market/news", "destination": "/api/news-ja" },
    { "source": "/healthz", "destination": "/api/health" },
    { "source": "/api/:path*", "destination": "/api?path=:path*" }
  ]
}
